{
  "uid": "pv-comparison",
  "title": "PV – Shelly vs. Fox ESS",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "PV Power – Shelly vs. Fox ESS",
      "description": "Shelly PM Mini (solar): measured AC power at the inverter feed, sign-inverted to positive. Fox ESS: pvPower (DC-side PV input) and generationPower (AC output). All values in Watts.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Shelly (solar)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Fox ESS – pvPower" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Fox ESS – generationPower" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (-power) AS \"Shelly (solar)\" FROM energy WHERE device = 'solar' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        },
        {
          "refId": "B", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (\"pvPower\" * 1000) AS \"Fox ESS – pvPower\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        },
        {
          "refId": "C", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (\"generationPower\" * 1000) AS \"Fox ESS – generationPower\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "DC String Power (pv1–pv4)",
      "description": "Power per PV string in Watts. On the M1-800-E only pv1 and pv2 are physically connected.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pv1Power" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "pv2Power" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "pv3Power" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "pv4Power" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (\"pv1Power\" * 1000) AS \"pv1Power\", (\"pv2Power\" * 1000) AS \"pv2Power\", (\"pv3Power\" * 1000) AS \"pv3Power\", (\"pv4Power\" * 1000) AS \"pv4Power\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "DC String Voltage (pv1–pv4)",
      "description": "Voltage per PV string in Volts.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "volt", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pv1Volt" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "pv2Volt" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "pv3Volt" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "pv4Volt" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, \"pv1Volt\" AS \"pv1Volt\", \"pv2Volt\" AS \"pv2Volt\", \"pv3Volt\" AS \"pv3Volt\", \"pv4Volt\" AS \"pv4Volt\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Feed-in Power (Fox ESS)",
      "description": "Power currently fed into the grid, in Watts.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "feedinPower" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (\"feedinPower\" * 1000) AS \"feedinPower\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Grid Consumption (Fox ESS)",
      "description": "Power currently drawn from the grid, in Watts.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, (\"gridConsumptionPower\" * 1000) AS \"gridConsumptionPower\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Grid Voltage & Frequency",
      "description": "AC grid voltage (V) and frequency (Hz) as seen by the inverter.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "RVolt" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "unit", "value": "volt" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RFreq" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "unit", "value": "hertz" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, \"RVolt\" AS \"RVolt\", \"RFreq\" AS \"RFreq\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Today's Yield (Fox ESS)",
      "description": "Total PV energy yield for today in kWh.",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "orange", "value": 1.0 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, \"todayYield\" AS \"todayYield\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time DESC LIMIT 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Lifetime Yield (Fox ESS)",
      "description": "Cumulative total PV energy generated since commissioning in kWh.",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, \"generation\" AS \"generation\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time DESC LIMIT 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Inverter Temperature",
      "description": "Inverter internal temperature in °C.",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 75 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-energy-raw" },
          "rawQuery": true,
          "rawSql": "SELECT time, \"invTemperation\" AS \"invTemperation\" FROM energy WHERE device = 'foxess-inverter' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    }
  ],
  "templating": { "list": [] }
}
