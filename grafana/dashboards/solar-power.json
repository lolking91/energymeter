{
  "uid": "solar-power",
  "title": "Solar (Shelly PM Mini)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Power (raw, as measured)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-energy-raw"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-energy-raw"
          },
          "rawQuery": true,
          "rawSql": "SELECT time, power FROM energy WHERE device = 'solar' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
