# Fox ESS Open API
# Generate your API key in the Fox ESS app: Me → API Management
FOXESS_API_KEY=your-foxess-api-key-here
FOXESS_DEVICE_SN=your-inverter-serial-number
# Leave at the default unless Fox ESS changes their API host
# FOXESS_BASE_URL=https://www.foxesscloud.com

# InfluxDB 3 (ersetzt INFLUXDB_ORG/INFLUXDB_BUCKET)
INFLUXDB_URL=http://influxdb:8181
INFLUXDB_TOKEN=your-influxdb-admin-token
INFLUXDB_DATABASE=energy_raw

# Shelly 3PM Mini (Solar)
SHELLY_SOLAR_HOST=192.168.x.x
# Shelly Pro 3PM (House and apartments)
SHELLY_HOUSE_TOTAL_HOST=192.168.x.x
SHELLY_UPPER_UNIT_HOST=192.168.x.x

# InfluxDB initial setup (used by the influxdb Docker container)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=changeme-secure-password
DOCKER_INFLUXDB_INIT_ORG=energymeter
DOCKER_INFLUXDB_INIT_BUCKET=energy
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=your-influxdb-admin-token

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-password

# Backend scheduling
# SCHEDULER_INTERVAL_MS=300000   # 5 minutes (default)
