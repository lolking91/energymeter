# Default: normalize line endings to LF on commit
* text=auto eol=lf

# Java / XML / YAML – always LF
*.java     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.properties text eol=lf
*.json     text eol=lf

# Shell scripts – always LF (important for Docker entrypoints)
*.sh       text eol=lf

# Windows scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Markdown / docs
*.md       text eol=lf

# Docker
Dockerfile text eol=lf

# Binaries – no line-ending conversion
*.jar      binary
*.class    binary
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.zip      binary
